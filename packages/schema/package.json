{
  "name": "@pool-drill-gen/schema",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run schema:generate && tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "schema:types": "node scripts/generate-types.mjs",
    "schema:validator": "node scripts/generate-validator.mjs",
    "schema:generate": "pnpm run schema:types && pnpm run schema:validator"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.6.3"
  }
}
